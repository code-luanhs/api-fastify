{
  "name": "api-fastify",
  "version": "1.0.0",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx --env-file=.env src/index.ts",
    "start": "node --env-file=.env .",
    "watch": "tsx --env-file=.env --watch src/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/cors": "^11.3.0",
    "better-sqlite3": "12.11.1",
    "chalk": "^6.0.1",
    "consola": "^3.4.2",
    "fastify": "^5.12.5",
    "http-status-codes": "^2.3.0",
    "quick.db": "^9.1.7",
    "zod": "^4.6.5"
  },
  "imports": {
    "#settings/*": [
      "./build/settings/*"
    ],
    "#functions/*": [
      "./build/functions/*"
    ],
    "#services/*": [
      "./build/services/*"
    ],
    "#controllers/*": [
      "./build/controllers/*"
    ],
    "#schemas/*": [
      "./build/database/schemas/*"
    ],
    "#database": [
      "./build/database/index.js"
    ]
  }
}
